# ── Groq (AI agent orchestration — required) ──────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── VAPI (AI voice calling — required for agentic caller feature) ──────────────
VAPI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── PostgreSQL (v2 features: chat, provider profiles — optional) ───────────────
# Default values match the docker-compose.yml setup. Leave as-is if using Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=serviceai
POSTGRES_USER=serviceai
POSTGRES_PASSWORD=serviceai_pass

# ── Redis (real-time WebSocket pub/sub — optional, used with PostgreSQL) ────────
REDIS_URL=redis://localhost:6379/0

# ── JWT (for v2 auth token signing) ───────────────────────────────────────────
# Change this to a long random string in any non-local environment.
JWT_SECRET=change-this-to-a-random-secret

# ── Firebase Admin SDK (optional) ─────────────────────────────────────────────
# Download your service account JSON from Firebase Console →
# Project Settings → Service Accounts → Generate new private key.
# Place it in serviceai-backend/ and set the path below.
# If left blank the backend falls back to unverified JWT decoding (fine for local dev).
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceaccount.json
